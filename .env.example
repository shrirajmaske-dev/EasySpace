# ==========================================================
# EasySpace Deployment Environment Variables (Vercel)
# ==========================================================
# In your Vercel Dashboard:
# Go to Project Settings -> Environment Variables.
# Select Production, Preview, and Development for each.

# ----------------------------------------------------------
# Backend Server / API Environment Variables
# ----------------------------------------------------------
NODE_ENV=production
CLIENT_URL=https://your-easyspace.vercel.app

# Google Gemini API (@google/genai)
# Obtain from https://aistudio.google.com/
# (Fallback: Built-in deterministic pedagogical AI synthesis engine)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key
# Obtain from Google Cloud Console (YouTube Data API v3)
# (Fallback: Curated academic video seed catalog)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Supabase Database & Auth (Server Service Role or Anon Key)
# Obtain from https://supabase.com/dashboard/project/<id>/settings/api
# (Fallback: Resilient in-memory/JSON persistent datastore)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# n8n Search Webhook URL (LearnLens Academic Workflow)
# Default production webhook provided below:
N8N_SEARCH_WEBHOOK_URL=https://ladepranav7.app.n8n.cloud/webhook/learnlens/search

# ----------------------------------------------------------
# Frontend Client Environment Variables (Vite - prefixed with VITE_)
# Note: Vite injects these during build time on Vercel.
# ----------------------------------------------------------
# If frontend & backend are deployed on the same Vercel project,
# VITE_API_BASE_URL can be omitted or set to /api/v1 (recommended).
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_N8N_SEARCH_WEBHOOK_URL=https://ladepranav7.app.n8n.cloud/webhook/learnlens/search
